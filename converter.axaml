<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GOHShaderModdingSupportLauncher.Properties"
             x:Class="GOHShaderModdingSupportLauncher.Converter">
  <ScrollViewer>
    <StackPanel Margin="30,12" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static loc:i18n.C_Path}" FontSize="24" VerticalAlignment="Center" />
        <TextBox x:Name="convertPath" Width="650" TextChanged="convertPath_TextChanged" />
        <Button x:Name="viewPath" Click="viewPath_Click"
                Content="{x:Static loc:i18n.C_ViewPath}" FontSize="20" />
      </StackPanel>
      <TabControl x:Name="Tabs" SelectedIndex="2" Height="200"
                  TabStripPlacement="Left">
        <TabItem Header="{x:Static loc:i18n.C_Tab_TextureRemap}" />
        <TabItem Header="{x:Static loc:i18n.C_Tab_TextureExtInj}" />
        <TabItem Header="{x:Static loc:i18n.C_Tab_MtlConvert}">
          <Button x:Name="enableEnvMaps" Height="50" Margin="5"
                  Click="enableEnvMaps_Click"
                  Content="{x:Static loc:i18n.C_EnableEnvMaps}" FontSize="18" />
        </TabItem>
      </TabControl>
      <TextBlock Text="{x:Static loc:i18n.C_Console}" FontSize="24"
                 FontWeight="Bold" Background="#4CA8B2BB" />
      <TextBox x:Name="console" Height="300" IsReadOnly="True"
               TextWrapping="Wrap" AcceptsReturn="True" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
