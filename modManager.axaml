<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GOHShaderModdingSupportLauncher"
             xmlns:loc="using:GOHShaderModdingSupportLauncher.Properties"
             x:Class="GOHShaderModdingSupportLauncher.ModManager"
             Loaded="Page_Loaded">
  <UserControl.Resources>
    <DataTemplate x:Key="ModFeaturesTemplate" x:DataType="local:Mod">
      <local:ModFeaturesView Mod="{Binding}" />
    </DataTemplate>
    <DataTemplate x:Key="ModFeaturesHeaderTemplate">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding MI_Features, Source={x:Static local:LocalizedStrings.Instance}}" VerticalAlignment="Center" />
        <TextBlock Name="modFeaturesHeaderHint" Text="ⓘ" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding MI_FeatureHint, Source={x:Static local:LocalizedStrings.Instance}}">
          <ToolTip.Tip>
            <local:ModFeatureHintView />
          </ToolTip.Tip>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.modName.alias">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="{Binding P_Presets, Source={x:Static local:LocalizedStrings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,4" />
      <ComboBox x:Name="presetList" MinWidth="180" MaxWidth="260" Margin="0,0,8,4" SelectionChanged="presetList_SelectionChanged" />
      <Button x:Name="savePreset" Click="savePreset_Click" Content="{Binding P_Save, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" />
      <Button x:Name="overwritePreset" Click="overwritePreset_Click" Content="{Binding P_Overwrite, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" IsEnabled="False" />
      <Button x:Name="loadPreset" Click="loadPreset_Click" Content="{Binding P_Load, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" IsEnabled="False" />
      <Button x:Name="renamePreset" Click="renamePreset_Click" Content="{Binding P_Rename, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" IsEnabled="False" />
      <Button x:Name="deletePreset" Click="deletePreset_Click" Content="{Binding P_Delete, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" IsEnabled="False" />
    </WrapPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,155,*" RowDefinitions="Auto,*" MinHeight="180">
      <TextBlock Grid.Column="0" Text="{Binding M_Available, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" />
      <TextBlock Grid.Column="2" Text="{Binding M_Loaded, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" />
      <DataGrid x:Name="unloadedMods" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False"
                IsReadOnly="True" SelectionMode="Extended" CanUserResizeColumns="True" CanUserSortColumns="True"
                SelectionChanged="unloadedMods_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{Binding M_GridName, Source={x:Static local:LocalizedStrings.Instance}}" CanUserSort="True"
                                  SortMemberPath="DisplayName" Width="230" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="local:Mod">
                <TextBlock Classes="modName" Classes.alias="{Binding HasAlias}" Text="{Binding DisplayName}"
                           ToolTip.Tip="{Binding name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn x:DataType="local:Mod" Header="{Binding MI_Source, Source={x:Static local:LocalizedStrings.Instance}}" CanUserSort="True"
                              Binding="{Binding SourceLabel}" />
          <DataGridTemplateColumn Header="{Binding MI_Features, Source={x:Static local:LocalizedStrings.Instance}}" CanUserSort="True"
                                  HeaderTemplate="{StaticResource ModFeaturesHeaderTemplate}"
                                  SortMemberPath="FeatureSortKey" Width="210" MinWidth="100" CellTemplate="{StaticResource ModFeaturesTemplate}" />
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="8">
        <Button x:Name="refresh" Click="refresh_Click" HorizontalAlignment="Center"
                Content="{Binding M_Refresh, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
        <Button x:Name="loadMod" Click="loadMod_Click" HorizontalAlignment="Center"
                Content="{Binding M_Load, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
        <Button x:Name="unloadMod" Click="unloadMod_Click" HorizontalAlignment="Center"
                Content="{Binding M_Unload, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      </StackPanel>
      <DataGrid x:Name="loadedMods" Grid.Row="1" Grid.Column="2" AutoGenerateColumns="False" Background="Transparent"
                IsReadOnly="True" SelectionMode="Extended" CanUserResizeColumns="True" CanUserSortColumns="False"
                SelectionChanged="loadedMods_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{Binding M_GridName, Source={x:Static local:LocalizedStrings.Instance}}"
                                  Width="230" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="local:Mod">
                <TextBlock Classes="modName" Classes.alias="{Binding HasAlias}" Text="{Binding DisplayName}"
                           ToolTip.Tip="{Binding name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn x:DataType="local:Mod" Header="{Binding MI_Source, Source={x:Static local:LocalizedStrings.Instance}}"
                              Binding="{Binding SourceLabel}" />
          <DataGridTemplateColumn Header="{Binding MI_Features, Source={x:Static local:LocalizedStrings.Instance}}"
                                  HeaderTemplate="{StaticResource ModFeaturesHeaderTemplate}"
                                  Width="210" MinWidth="100" CellTemplate="{StaticResource ModFeaturesTemplate}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding M_SelectedMod, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="24"
               FontWeight="Bold" Background="#4CA8B2BB" Margin="0,6" />
    <WrapPanel Grid.Row="3">
      <Button x:Name="viewModSubscription" Click="viewModSubscription_Click" IsVisible="False"
              Content="{Binding M_ViewSubscription, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" Margin="0,0,8,4" />
      <Button x:Name="openModFolder" Click="openModFolder_Click"
              Content="{Binding M_OpenFolder, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" Margin="0,0,8,4" />
      <Button x:Name="loadShaderCache" Click="loadShaderCache_Click"
              Content="{Binding M_LoadCache, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" Margin="0,0,8,4" />
      <Button x:Name="collectShaderCache" Click="collectShaderCache_Click"
              Content="{Binding M_CollectCache, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" Margin="0,0,8,4" />
      <Button x:Name="editModAlias" Click="editModAlias_Click" IsEnabled="False"
              Content="{Binding MA_EditAlias, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" Margin="0,0,8,4" />
    </WrapPanel>
  </Grid>
</UserControl>
