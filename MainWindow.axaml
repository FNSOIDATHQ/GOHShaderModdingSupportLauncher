<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GOHShaderModdingSupportLauncher"
        x:Class="GOHShaderModdingSupportLauncher.MainWindow"
        Title="{Binding Title, Source={x:Static local:LocalizedStrings.Instance}}"
        Icon="avares://GOHShaderModdingSupportLauncher/gemIconBg.ico"
        Width="1700" Height="800" MinWidth="900" MinHeight="600"
        Background="#20242C" WindowDecorations="None" CanResize="True"
        WindowStartupLocation="CenterScreen"
        Closed="OnClosed">
  <Window.Resources>
    <SolidColorBrush x:Key="NavigationChromeBrush" Color="#B31C1C1C" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.captionButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.captionButton:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.captionButton.closeButton:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="ListBox.sidebarNavigation ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.navigationIcon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Width" Value="24" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.navigationLabel">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="SplitView.compactNavigation TextBlock.navigationLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="SplitView.compactNavigation Border.navigationBetaBadge">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>
  <Grid x:Name="windowLayout" RowDefinitions="56,*">
    <Grid.Background>
      <ImageBrush Source="avares://GOHShaderModdingSupportLauncher/bg.jpg"
                  Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Top"
                  Opacity="0.4" />
    </Grid.Background>
    <Border x:Name="titleBar" Grid.Row="0"
            Background="{StaticResource NavigationChromeBrush}"
            PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="17"
                   FontWeight="SemiBold" Foreground="White"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Margin="18,0,12,0" />
        <StackPanel x:Name="captionButtons" Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="minimizeButton" Classes="captionButton"
                  Width="52" Height="56" FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE921;"
                  Click="MinimizeButton_Click" />
          <Button x:Name="maximizeButton" Classes="captionButton"
                  Width="52" Height="56" FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE922;"
                  Click="MaximizeButton_Click" />
          <Button x:Name="closeButton" Classes="captionButton closeButton"
                  Width="52" Height="56" FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE8BB;"
                  Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <SplitView x:Name="mainView" Grid.Row="1" DisplayMode="CompactInline" IsPaneOpen="True"
               OpenPaneLength="240" CompactPaneLength="52" Background="Transparent"
               PaneBackground="{StaticResource NavigationChromeBrush}">
      <SplitView.Pane>
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Button x:Name="navigationToggle" Width="44" Height="36" Margin="4"
                  Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets"
                  Content="&#xE700;" FontSize="18" HorizontalContentAlignment="Center"
                  Click="NavigationToggle_Click" />
          <ListBox x:Name="primaryNavigation" Grid.Row="1" Classes="sidebarNavigation" Padding="0"
                   Background="Transparent" BorderThickness="0"
                   SelectionChanged="PrimaryNavigation_SelectionChanged">
            <ListBoxItem Tag="Launcher" ToolTip.Tip="{Binding Tab_Launcher, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_Launcher, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE80F;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_Launcher, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
            <ListBoxItem Tag="ModManager" ToolTip.Tip="{Binding Tab_ModManager, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_ModManager, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE8F1;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_ModManager, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
            <ListBoxItem Tag="ModSubscriptions" ToolTip.Tip="{Binding Tab_ModSubscriptions, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_ModSubscriptions, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="navigationIcon" Text="&#xE896;" />
                <TextBlock x:Name="subscriptionCompactBadge" IsVisible="False" Text="●" FontSize="10"
                           Foreground="#FFD080" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <TextBlock x:Name="subscriptionNavigationLabel" Grid.Column="1" Classes="navigationLabel"
                           Text="{Binding Tab_ModSubscriptions, Source={x:Static local:LocalizedStrings.Instance}}" />
                <Border x:Name="subscriptionBetaBadge" Grid.Column="2" Classes="navigationBetaBadge"
                        Background="Transparent" BorderBrush="White" BorderThickness="1"
                        CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Tab_ModSubscriptionsBeta, Source={x:Static local:LocalizedStrings.Instance}}"
                             Foreground="White" FontSize="11" />
                </Border>
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Converter" ToolTip.Tip="{Binding Tab_Converter, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_Converter, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE8AB;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_Converter, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Tools" ToolTip.Tip="{Binding Tab_Tools, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_Tools, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE90F;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_Tools, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
          </ListBox>
          <StackPanel x:Name="languagePanel" Grid.Row="2" Margin="12,8,12,6" Spacing="4">
            <TextBlock Text="Language / 语言" Foreground="White" />
            <ComboBox x:Name="languageSelector" HorizontalAlignment="Stretch"
                      SelectionChanged="LanguageSelector_SelectionChanged">
              <ComboBoxItem Content="English" Tag="en-US" />
              <ComboBoxItem Content="中文" Tag="zh-CN" />
            </ComboBox>
          </StackPanel>
          <Button x:Name="languageButton" Grid.Row="2" IsVisible="False" IsEnabled="False"
                  Width="44" Height="40" Margin="4,6" FontFamily="Segoe MDL2 Assets" Content="&#xE774;"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Language / 语言" AutomationProperties.Name="Language / 语言">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="English" Tag="en-US" Click="LanguageMenu_Click" />
                <MenuItem Header="中文" Tag="zh-CN" Click="LanguageMenu_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <ListBox x:Name="footerNavigation" Grid.Row="3" Classes="sidebarNavigation" Padding="0"
                   Background="Transparent" BorderThickness="0"
                   SelectionChanged="FooterNavigation_SelectionChanged">
            <ListBoxItem Tag="Settings" ToolTip.Tip="{Binding Tab_Settings, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_Settings, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE713;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_Settings, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
            <ListBoxItem Tag="About" ToolTip.Tip="{Binding Tab_About, Source={x:Static local:LocalizedStrings.Instance}}"
                         AutomationProperties.Name="{Binding Tab_About, Source={x:Static local:LocalizedStrings.Instance}}">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="navigationIcon" Text="&#xE946;" />
                <TextBlock Grid.Column="1" Classes="navigationLabel" Text="{Binding Tab_About, Source={x:Static local:LocalizedStrings.Instance}}" /></Grid>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </SplitView.Pane>
      <SplitView.Content>
        <ContentControl x:Name="pageHost" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </SplitView.Content>
    </SplitView>
    <Grid x:Name="resizeGrips" Grid.RowSpan="2">
      <Border Tag="North" Height="6" VerticalAlignment="Top" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="South" Height="6" VerticalAlignment="Bottom" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="West" Width="6" HorizontalAlignment="Left" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="East" Width="6" HorizontalAlignment="Right" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeGrip_PointerPressed" />
      <Border Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeGrip_PointerPressed" />
    </Grid>
  </Grid>
</Window>
