<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GOHShaderModdingSupportLauncher"
             x:Class="GOHShaderModdingSupportLauncher.Settings">
  <ScrollViewer>
    <StackPanel Margin="15" Spacing="8">
      <TextBlock x:Name="pathStatus" TextWrapping="Wrap" Foreground="#FFD27F"
                 Text="{Binding S_PathsRequired, Source={x:Static local:LocalizedStrings.Instance}}" />
      <TextBlock Text="{Binding S_General, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="24"
                 FontWeight="Bold" Background="#4CA8B2BB" />
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Text="{Binding S_GamePath, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" VerticalAlignment="Center" />
        <TextBox x:Name="gamePath" Grid.Column="1" Margin="8,0,0,0"
                 LostFocus="gamePath_LostFocus" />
        <Button x:Name="browseGamePath" Grid.Column="2" Margin="8,0,0,0"
                Click="browseGamePath_Click"
                Content="{Binding S_Browse, Source={x:Static local:LocalizedStrings.Instance}}" />
        <TextBlock Grid.Row="1" Text="{Binding S_GameConfigPath, Source={x:Static local:LocalizedStrings.Instance}}"
                   FontSize="20" VerticalAlignment="Center" />
        <TextBox x:Name="gameConfigPath" Grid.Row="1" Grid.Column="1"
                 Margin="8,0,0,0" LostFocus="gameConfigPath_LostFocus" />
        <Button x:Name="browseGameConfigPath" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"
                Click="browseGameConfigPath_Click"
                Content="{Binding S_Browse, Source={x:Static local:LocalizedStrings.Instance}}" />
        <TextBlock Grid.Row="2" Text="{Binding S_ProfileAccount, Source={x:Static local:LocalizedStrings.Instance}}"
                   FontSize="20" VerticalAlignment="Center" />
        <ComboBox x:Name="profileAccount" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="8,0,0,0" HorizontalAlignment="Stretch"
                  SelectionChanged="profileAccount_SelectionChanged" />
      </Grid>
      <CheckBox x:Name="pathConfirm" Click="pathConfirm_Click"
                Content="{Binding S_PathConfirm, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="hideDonationBanner" Click="hideDonationBanner_Click"
                Content="{Binding S_HideDonationBanner, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <TextBlock Text="{Binding S_BeforeLaunch, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="24"
                 FontWeight="Bold" Background="#4CA8B2BB" />
      <CheckBox x:Name="autoLoadCache" Click="autoLoadCache_Click"
                Content="{Binding S_AutoLoadCache, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="refreshCacheWhenModified" Click="refreshCacheWhenModified_Click"
                Content="{Binding S_RefreshCache, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <TextBlock Text="{Binding S_AfterGame, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="24"
                 FontWeight="Bold" Background="#4CA8B2BB" />
      <CheckBox x:Name="restore" Click="restore_Click"
                Content="{Binding S_Restore, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="clearCache" Click="clearCache_Click"
                Content="{Binding S_Clear, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="gameExit" Click="gameExit_Click"
                Content="{Binding S_GameExit, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="compileWarning" Click="compileWarning_Click"
                Content="{Binding S_CompileWarning, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <CheckBox x:Name="lockModList" Click="lockModList_Click"
                Content="{Binding S_LockModList, Source={x:Static local:LocalizedStrings.Instance}}" FontSize="20" />
      <Expander x:Name="modAliasesExpander" HorizontalAlignment="Stretch"
                Header="{Binding MA_Title, Source={x:Static local:LocalizedStrings.Instance}}">
        <StackPanel x:Name="modAliasesPanel" Spacing="8" Margin="0,8">
          <TextBlock Text="{Binding MA_Hint, Source={x:Static local:LocalizedStrings.Instance}}" TextWrapping="Wrap" />
          <CheckBox x:Name="enableItemAliases" Click="enableItemAliases_Click"
                    Content="{Binding MA_EnableItemMapping, Source={x:Static local:LocalizedStrings.Instance}}" />
          <TextBox x:Name="aliasSearch" TextChanged="aliasSearch_TextChanged"
                   PlaceholderText="{Binding MA_Search, Source={x:Static local:LocalizedStrings.Instance}}"
                   AutomationProperties.Name="{Binding MA_Search, Source={x:Static local:LocalizedStrings.Instance}}" />
          <DataGrid x:Name="aliasRules" Height="210" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" CanUserSortColumns="False" CanUserResizeColumns="True"
                    SelectionChanged="aliasRules_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{Binding MA_RuleType, Source={x:Static local:LocalizedStrings.Instance}}" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ModAliasRule">
                    <TextBlock Text="{Binding KindLabel}" Margin="8,0" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{Binding MA_Target, Source={x:Static local:LocalizedStrings.Instance}}" Width="*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ModAliasRule">
                    <TextBlock Text="{Binding TargetLabel}" ToolTip.Tip="{Binding TargetLabel}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{Binding MA_Alias, Source={x:Static local:LocalizedStrings.Instance}}" Width="*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ModAliasRule">
                    <TextBlock Text="{Binding Alias}" ToolTip.Tip="{Binding Alias}" TextTrimming="CharacterEllipsis" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="aliasEmpty" Text="{Binding MA_Empty, Source={x:Static local:LocalizedStrings.Instance}}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MA_RuleType, Source={x:Static local:LocalizedStrings.Instance}}" />
          <ComboBox x:Name="aliasRuleKind" SelectedIndex="0" SelectionChanged="aliasRuleKind_SelectionChanged"
                    AutomationProperties.Name="{Binding MA_RuleType, Source={x:Static local:LocalizedStrings.Instance}}">
            <ComboBoxItem Content="{Binding MA_KindField, Source={x:Static local:LocalizedStrings.Instance}}" />
            <ComboBoxItem Content="{Binding MA_KindItem, Source={x:Static local:LocalizedStrings.Instance}}" />
          </ComboBox>
          <StackPanel x:Name="aliasNameEditor" Spacing="6">
            <TextBlock Text="{Binding MA_OriginalName, Source={x:Static local:LocalizedStrings.Instance}}" />
            <TextBox x:Name="aliasOriginalName" MaxLength="1024" TextChanged="aliasDraft_TextChanged"
                     AutomationProperties.Name="{Binding MA_OriginalName, Source={x:Static local:LocalizedStrings.Instance}}" />
          </StackPanel>
          <StackPanel x:Name="aliasItemEditor" Spacing="6" IsVisible="False">
            <TextBox x:Name="aliasWorkshopSearch" TextChanged="aliasWorkshopSearch_TextChanged"
                     PlaceholderText="{Binding MA_WorkshopSearch, Source={x:Static local:LocalizedStrings.Instance}}"
                     AutomationProperties.Name="{Binding MA_WorkshopSearch, Source={x:Static local:LocalizedStrings.Instance}}" />
            <ComboBox x:Name="aliasWorkshopResults" SelectionChanged="aliasWorkshopResults_SelectionChanged" HorizontalAlignment="Stretch"
                      PlaceholderText="{Binding MA_WorkshopSelect, Source={x:Static local:LocalizedStrings.Instance}}"
                      AutomationProperties.Name="{Binding MA_WorkshopSelect, Source={x:Static local:LocalizedStrings.Instance}}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="aliasUrl" MaxLength="4096" TextChanged="aliasUrl_TextChanged"
                       PlaceholderText="{Binding MA_ItemUrl, Source={x:Static local:LocalizedStrings.Instance}}"
                       AutomationProperties.Name="{Binding MA_ItemUrl, Source={x:Static local:LocalizedStrings.Instance}}" />
              <Button Grid.Column="1" x:Name="aliasResolve" Click="aliasResolve_Click"
                      Content="{Binding MA_ResolveItem, Source={x:Static local:LocalizedStrings.Instance}}" />
            </Grid>
            <TextBlock x:Name="aliasItemTarget" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding MA_Alias, Source={x:Static local:LocalizedStrings.Instance}}" />
          <TextBox x:Name="aliasValue" MaxLength="1024" TextChanged="aliasDraft_TextChanged"
                   AutomationProperties.Name="{Binding MA_Alias, Source={x:Static local:LocalizedStrings.Instance}}" />
          <TextBox x:Name="aliasPreviewName" MaxLength="1024" TextChanged="aliasDraft_TextChanged"
                   PlaceholderText="{Binding MA_SampleName, Source={x:Static local:LocalizedStrings.Instance}}"
                   AutomationProperties.Name="{Binding MA_SampleName, Source={x:Static local:LocalizedStrings.Instance}}" />
          <TextBlock x:Name="aliasPreview" TextWrapping="Wrap" IsVisible="False" />
          <WrapPanel>
            <Button x:Name="saveAliasRule" Click="saveAliasRule_Click" Content="{Binding MA_Save, Source={x:Static local:LocalizedStrings.Instance}}" Margin="0,0,8,4" />
            <Button x:Name="deleteAliasRule" Click="deleteAliasRule_Click" Content="{Binding MA_Delete, Source={x:Static local:LocalizedStrings.Instance}}" IsEnabled="False" Margin="0,0,8,4" />
          </WrapPanel>
          <TextBlock x:Name="aliasError" Foreground="#FFD27F" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
